# Copia este archivo a ".env" (mismo directorio) si quieres apuntar el
# frontend a un backend distinto del local (ej. tu API desplegada en Render).
# Vite solo lee variables que empiecen con VITE_, y las incrusta en el
# bundle en tiempo de BUILD (no en runtime).

# URL completa del API del backend, incluyendo "/api".
VITE_API_URL=http://localhost:8095/api

# Llave pública VAPID para suscribirse a notificaciones push (PWA) — la
# MISMA llave pública que VAPID_PUBLIC_KEY del backend (ver .env.example
# raíz), no una distinta. Sin ella, el toggle de "Activar notificaciones"
# en Perfil no aparece.
VITE_VAPID_PUBLIC_KEY=

# Teléfono de soporte de ProPatient, con "+" y código de país (ej.
# "+5215512345678") — el MISMO número que TWILIO_WHATSAPP_FROM del backend
# (ver .env.example raíz), sin el prefijo "whatsapp:". Arma el botón
# "¿Necesitas ayuda?" del sidebar del doctor (link https://wa.me/...) — sin
# esta variable, el botón no aparece.
VITE_SUPPORT_WHATSAPP_NUMBER=

# Copia este archivo a ".env" (mismo directorio) y define valores propios.
# El ".env" real NUNCA debe subirse a git (ya está en .gitignore).

# Contraseña del usuario "postgres" en el contenedor de base de datos.
POSTGRES_PASSWORD=changeme_local_dev_only

# Secreto usado para firmar los JWT de sesión. Usa un valor largo y aleatorio
# en cualquier ambiente que no sea tu máquina local, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=changeme_local_dev_only

# Client ID de Google OAuth usado para validar el login social (debe coincidir
# con el client_id configurado en propatient-frontend/src/pages/Login.tsx).
GOOGLE_CLIENT_ID=744896665247-hrs7pmi72q2pog5dn9h1fh5n4nkpv18r.apps.googleusercontent.com

# URL del frontend permitida por CORS en el backend. Acepta varias separadas
# por coma (ej. local + producción): "http://localhost:5173,https://mi-app.onrender.com"
FRONTEND_URL=http://localhost:5173

# Crea el doctor de prueba "medico"/"12345" al arrancar (ver PROJECT_SPECS.md).
# SOLO para desarrollo local: docker-compose.yml ya la define en "true" por
# defecto. NUNCA definas esto en Render/producción — esa cuenta tiene una
# contraseña conocida públicamente (está documentada en este mismo repo).
ENABLE_TEST_SEED=true

# --- Integración opcional: sincronizar citas con Google Calendar ---
# Sin estas tres variables, la app funciona igual pero el botón "Conectar con
# Google Calendar" del Perfil del doctor queda deshabilitado (503).
# Usa un OAuth Client ID de tipo "Web application" SEPARADO del
# GOOGLE_CLIENT_ID de arriba (ese es público, sin secret, y no tiene el scope
# de Calendar). Client Secret nunca se publica ni se sube al repo.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback registrada en "Authorized redirect URIs" de ESE Client ID.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8095/api/auth/google-calendar/callback

# --- Integración opcional: guardar archivos (documentos, recetas, logo/
# avatar, INE) en un bucket S3 privado en vez del disco local. ---
# Sin AWS_S3_BUCKET/AWS_REGION, la app sigue funcionando igual que siempre
# (disco local, ./uploads) — útil para desarrollar sin cuenta de AWS. Con
# las cuatro configuradas, todo se sube a S3 y se sirve con URLs firmadas
# temporales (nadie accede a un archivo sin pasar antes por el backend).
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY son los nombres estándar que usa
# el SDK de AWS directamente (no son variables inventadas de este proyecto).
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Envío de correos (Resend) — invitación de personal, solicitud de cita
# pública, aviso al doctor de solicitud nueva, validación de cédula,
# recordatorio de cita 24h antes ---
# Se manda por la API HTTP de Resend (resend.com), NO por SMTP: varios
# hostings (Render incluido) bloquean las conexiones salientes por el
# puerto SMTP, lo que hacía que el envío se quedara colgado hasta agotar el
# timeout de red en vez de fallar rápido.
#
# RESEND_API_KEY: se genera en el dashboard de Resend (resend.com/api-keys).
# RESEND_FROM_EMAIL: remitente completo, ej.
# "ProPatient <notificaciones@tudominio.com>". Requiere verificar un
# dominio propio en Resend (resend.com/domains, agrega unos registros DNS).
# Mientras no lo verifiques, si dejas esta variable vacía se usa el
# dominio de pruebas de Resend ("onboarding@resend.dev"), que SOLO entrega
# correos a la cuenta dueña de la API key — sirve para probar el flujo
# completo tú mismo, pero no para pacientes reales.
#
# Sin RESEND_API_KEY, la app sigue funcionando: el correo simplemente no se
# manda (falla rápido, sin bloquear la petición) y esos flujos se pueden
# reintentar más adelante (el recordatorio, en particular, se reintenta
# solo en la siguiente pasada del worker).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Integración opcional: cobro de suscripción con Stripe ---
# Sin estas tres variables, la app funciona igual pero el botón
# "Suscribirse" del Perfil de Facturación queda deshabilitado (503) — solo
# afecta el bloqueo tras el periodo de prueba, no el resto de la app. Ver
# la guía de configuración: crear el producto/precio recurrente en Stripe,
# copiar el Price ID, la Secret key y el Webhook signing secret (Developers
# → Webhooks → agregar endpoint apuntando a
# <URL_DEL_BACKEND>/api/billing/webhook, eventos checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Plan de clínica: cobro base de $5,000 MXN/mes (cubre hasta 5 doctores) +
# $1,000 MXN/mes por cada doctor adicional. Crea dos Prices en Stripe (uno
# fijo, otro de cantidad variable) y pega sus IDs aquí. Si cualquiera de
# las dos queda vacía, el plan de clínica se comporta como no configurado
# (las rutas /api/clinic devuelven 503) — un doctor individual sigue
# pudiendo suscribirse igual con STRIPE_PRICE_ID de arriba.
STRIPE_CLINIC_BASE_PRICE_ID=
STRIPE_CLINIC_EXTRA_DOCTOR_PRICE_ID=

# --- Envío de WhatsApp (Twilio) ---
# Mismos avisos que el correo (solicitud de cita pública, aviso al doctor,
# confirmación/rechazo, seguimiento, recordatorio al paciente, invitación a
# reseña) pero por WhatsApp. Sin estas tres, la app funciona igual, solo no
# se manda el WhatsApp (mejor esfuerzo, igual que el correo). El
# recordatorio al DOCTOR 60 min antes de la cita ya no usa WhatsApp, se
# movió a correo (el doctor ya tiene que entrar a la app para iniciar la
# consulta, no justificaba el costo de ese canal).
#
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN: en el dashboard de Twilio
# (console.twilio.com), en la página principal.
# TWILIO_WHATSAPP_FROM: el número de WhatsApp habilitado, CON el prefijo
# "whatsapp:", ej. "whatsapp:+14155238886" (número de sandbox de pruebas de
# Twilio) o tu número de negocio ya aprobado por Meta.
#
# Importante sobre el sandbox: mientras no apruebes un número de negocio
# real, cada persona (doctor o paciente) que vaya a RECIBIR mensajes debe
# mandarle una vez, por WhatsApp, el código de "join" al número de sandbox
# antes de que Twilio le entregue cualquier mensaje — sirve para probar el
# flujo completo, pero no para producción con pacientes que no lo sepan.
#
# Los teléfonos de doctores/pacientes se guardan como texto libre sin
# código de país (ej. "5512345678"); si no traen "+", se asume México
# (+52) automáticamente al mandarlos por WhatsApp (ver
# internal/whatsapp.NormalizeE164).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# TWILIO_WEBHOOK_URL: la bandeja de WhatsApp del superadmin recibe las
# respuestas de pacientes/doctores en POST /api/whatsapp/webhook — esta
# variable debe ser la URL pública EXACTA que le des de alta a Twilio en
# console.twilio.com > Messaging > Senders > (tu número) > Configuration >
# "When a message comes in", ej.
# "https://api.propatient.pro/api/whatsapp/webhook". Sin esto (o si no
# coincide carácter por carácter con lo configurado en Twilio), el webhook
# rechaza todos los mensajes entrantes por firma inválida — ver
# internal/whatsapp.ValidateInboundSignature.
TWILIO_WEBHOOK_URL=

# --- Plantillas de WhatsApp (Content API de Twilio) ---
# Fuera del sandbox, Meta EXIGE que los mensajes que el negocio inicia
# (todos los de arriba, ninguno es respuesta a algo que el paciente
# escribió primero) vayan por una plantilla pre-aprobada — el texto libre
# se rechaza fuera de la ventana de 24h. Además, categoría "utility"
# (transaccional, que es lo que son todos estos avisos) cuesta bastante
# menos que "marketing" en el cobro de Meta.
#
# Cómo activarlas: da de alta cada plantilla en el Content Editor de
# Twilio (o en el WhatsApp Manager de Meta Business), pide que Meta la
# apruebe como categoría "utility", y pega aquí el Content Sid (empieza
# con "HX..."). Mientras una variable se quede vacía, ese aviso sigue
# mandándose por texto libre igual que antes (sirve para no bloquear el
# deploy mientras esperas la aprobación de cada plantilla) — ver
# internal/whatsapp.SendWithFallback.
#
# Variables esperadas en cada plantilla (en este orden, {{1}} {{2}} ...):
# BOOKING_PATIENT:         nombre del paciente, nombre del doctor, fecha/hora
# BOOKING_DOCTOR:          nombre completo del paciente, fecha/hora, motivo
# APPOINTMENT_CONFIRMED:   nombre del doctor, fecha/hora
# APPOINTMENT_REJECTED:    nombre del doctor, fecha/hora
# APPOINTMENT_CANCELLED:   nombre del doctor, fecha/hora (cita YA confirmada que se cancela)
# APPOINTMENT_RESCHEDULED: nombre del doctor, nueva fecha/hora
# REMINDER_PATIENT:        nombre del paciente, nombre del doctor, fecha/hora
# REVIEW_REQUEST:          nombre del paciente, nombre del doctor, link
# FOLLOWUP:                nombre del paciente, nombre del doctor, fecha/hora
#
# (El recordatorio al doctor 60 min antes de la cita ya NO va por WhatsApp,
# se movió a correo — no tiene plantilla.)
#
# Para los avisos al PACIENTE (booking, confirmado, rechazado, cancelado,
# reprogramado, recordatorio), el correo solo se manda como respaldo si el
# WhatsApp no se pudo entregar (sin Twilio configurado, sin teléfono, o
# falla el envío) — ver internal/handlers/appointment_handler.go y
# public_handler.go. Evita mandarle el mismo aviso dos veces por canales
# distintos.
TWILIO_TEMPLATE_BOOKING_PATIENT=
TWILIO_TEMPLATE_BOOKING_DOCTOR=
TWILIO_TEMPLATE_APPOINTMENT_CONFIRMED=
TWILIO_TEMPLATE_APPOINTMENT_REJECTED=
TWILIO_TEMPLATE_APPOINTMENT_CANCELLED=
TWILIO_TEMPLATE_APPOINTMENT_RESCHEDULED=
TWILIO_TEMPLATE_APPOINTMENT_BOOKED_BY_DOCTOR=
TWILIO_TEMPLATE_REMINDER_PATIENT=
TWILIO_TEMPLATE_REVIEW_REQUEST=
TWILIO_TEMPLATE_FOLLOWUP=

# --- Notificaciones push (Web Push / VAPID) ---
# Le avisan al doctor de una nueva solicitud de cita pública como
# notificación nativa en su celular/tablet, si instaló la app (PWA) desde
# el navegador y activó el toggle de notificaciones en su Perfil. Sin
# estas tres, la app funciona igual — el toggle de activarlas simplemente
# no aparece (mejor esfuerzo, mismo criterio que WhatsApp/correo).
#
# Cómo generarlas (una sola vez, no cambian salvo que quieras rotarlas):
#   npx web-push generate-vapid-keys
# o, con el mismo paquete Go que usa el backend:
#   go run github.com/SherClockHolmes/webpush-go/cmd/webpush-gen-vapid-keys@latest
# (si ese comando no existe en la versión instalada, generar desde un
# script Go de una línea con webpush.GenerateVAPIDKeys() basta).
#
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: el par de llaves generado arriba.
# VAPID_PUBLIC_KEY se necesita TAMBIÉN en el frontend, como
# VITE_VAPID_PUBLIC_KEY (ver propatient-frontend/.env.example) — es la
# misma llave pública en los dos lados, no una distinta.
# VAPID_SUBJECT: un "mailto:" o una URL que identifique al remitente ante
# el navegador — usa tu correo o "https://propatient.pro".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alejandrobuenomendoza@gmail.com

# --- Panel interno de administración (revisión de cédula profesional) ---
# Crea la primera cuenta de models.SuperAdmin al arrancar, solo si todavía
# no existe ninguna (ver internal/database.SeedSuperAdmin). A propósito NO
# hay un usuario/contraseña por defecto: sin estas dos variables, el panel
# en /admin/login queda inaccesible hasta que las definas. Usa una
# contraseña fuerte — esta cuenta puede aprobar la cédula de cualquier
# doctor.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# --- Geocodificación (ubicar el consultorio en el mapa) ---
# Sin esta variable, el backend usa Nominatim (OpenStreetMap, gratis, sin
# API key) — pero Nominatim bloquea/limita seguido las peticiones que vienen
# de servidores en la nube compartidos (como Render), así que se recomienda
# LocationIQ: crea una cuenta gratis en https://locationiq.com (plan de
# 5,000 consultas/día) y pega aquí tu "Access Token".
LOCATIONIQ_API_KEY=

# --- reCAPTCHA v3 (protección anti-bot en el agendado público de citas) ---
# Sin esta variable, la app funciona igual pero SIN esta capa extra —
# queda solo el rate limiting por IP (ver internal/middleware). Crea un
# sitio reCAPTCHA v3 en https://www.google.com/recaptcha/admin, agrega el
# dominio real del frontend, y copia aquí la "Secret key" (la "Site key"
# va del lado del frontend, ver propatient-frontend/.env.example).
RECAPTCHA_SECRET_KEY=

# --- Sentry (reporte de errores del backend) ---
# Sin SENTRY_DSN, el backend funciona igual pero no reporta errores ni
# panics a ningún lado — solo quedan en los logs del servidor. Crea un
# proyecto Go en https://sentry.io y pega aquí su DSN.
SENTRY_DSN=
# Opcional: distingue ambientes dentro del mismo proyecto de Sentry
# (ej. "production" vs "staging"). Sin definirla, asume "production".
SENTRY_ENVIRONMENT=production

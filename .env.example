# Copia este archivo a ".env" (mismo directorio) y define valores propios.
# El ".env" real NUNCA debe subirse a git (ya está en .gitignore).

# Contraseña del usuario "postgres" en el contenedor de base de datos.
POSTGRES_PASSWORD=changeme_local_dev_only

# Secreto usado para firmar los JWT de sesión. Usa un valor largo y aleatorio
# en cualquier ambiente que no sea tu máquina local, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=changeme_local_dev_only

# Client ID de Google OAuth usado para validar el login social (debe coincidir
# con el client_id configurado en propatient-frontend/src/pages/Login.tsx).
GOOGLE_CLIENT_ID=744896665247-hrs7pmi72q2pog5dn9h1fh5n4nkpv18r.apps.googleusercontent.com

# URL del frontend permitida por CORS en el backend. Acepta varias separadas
# por coma (ej. local + producción): "http://localhost:5173,https://mi-app.onrender.com"
FRONTEND_URL=http://localhost:5173

# --- Integración opcional: sincronizar citas con Google Calendar ---
# Sin estas tres variables, la app funciona igual pero el botón "Conectar con
# Google Calendar" del Perfil del doctor queda deshabilitado (503).
# Usa un OAuth Client ID de tipo "Web application" SEPARADO del
# GOOGLE_CLIENT_ID de arriba (ese es público, sin secret, y no tiene el scope
# de Calendar). Client Secret nunca se publica ni se sube al repo.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback registrada en "Authorized redirect URIs" de ESE Client ID.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8095/api/auth/google-calendar/callback

# --- Integración opcional: guardar archivos (documentos, recetas, logo/
# avatar, INE) en un bucket S3 privado en vez del disco local. ---
# Sin AWS_S3_BUCKET/AWS_REGION, la app sigue funcionando igual que siempre
# (disco local, ./uploads) — útil para desarrollar sin cuenta de AWS. Con
# las cuatro configuradas, todo se sube a S3 y se sirve con URLs firmadas
# temporales (nadie accede a un archivo sin pasar antes por el backend).
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY son los nombres estándar que usa
# el SDK de AWS directamente (no son variables inventadas de este proyecto).
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Envío de correos (invitación de personal, solicitud de cita pública,
# aviso al doctor de solicitud nueva, recordatorio de cita 24h antes) ---
# Una sola cuenta de Gmail manda todos los correos del sistema, para todos
# los doctores. Sin estas dos, la app sigue funcionando: el correo
# simplemente no se manda (falla rápido, sin bloquear la petición) y esos
# flujos se pueden reintentar más adelante (el recordatorio, en particular,
# se reintenta solo en la siguiente pasada del worker). Requiere una cuenta
# de Gmail con verificación en dos pasos y una "contraseña de aplicación"
# generada en https://myaccount.google.com/apppasswords (NO la contraseña
# normal de la cuenta).
SMTP_EMAIL=
SMTP_PASSWORD=

# --- Integración opcional: cobro de suscripción con Stripe ---
# Sin estas tres variables, la app funciona igual pero el botón
# "Suscribirse" del Perfil de Facturación queda deshabilitado (503) — solo
# afecta el bloqueo tras el periodo de prueba, no el resto de la app. Ver
# la guía de configuración: crear el producto/precio recurrente en Stripe,
# copiar el Price ID, la Secret key y el Webhook signing secret (Developers
# → Webhooks → agregar endpoint apuntando a
# <URL_DEL_BACKEND>/api/billing/webhook, eventos checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
